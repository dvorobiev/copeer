import os
import subprocess
import time
import pandas as pd
from rich.console import Console
from rich.table import Table
from rich.prompt import Prompt
from rich.text import Text
import shutil
import logging

# --- Конфигурация ---
CSV_FILE = 'DISK_WWN.csv'
SERIAL_PORT = '/dev/ttyUSB0'
MAX_ACTIVE_DISKS = 10
DISK_POWER_ON_DELAY_SEC = 20 # Оставим увеличенное значение
MOUNT_OPTIONS = "noatime,nodiratime,logbufs=8,logbsize=256k,largeio,inode64,swalloc,allocsize=131072k"
LOG_FILE = 'disk_manager.log'

# <<< ИЗМЕНЕНО: Добавляем базовый путь для всех точек монтирования
MOUNT_BASE_PATH = "/mnt/"


class DiskManager:
    """
    Утилита для управления дисковыми полками через серийный порт.
    """
    def __init__(self, csv_path, serial_port):
        self.serial_port = serial_port
        self.console = Console()
        self.setup_logging()
        
        try:
            self.df = pd.read_csv(csv_path, sep=';')
            
            # <<< ИЗМЕНЕНО: Преобразуем относительные пути в абсолютные СРАЗУ ПОСЛЕ ЗАГРУЗКИ
            self.logger.info(f"Преобразование точек монтирования. Базовый путь: '{MOUNT_BASE_PATH}'")
            # Эта строка добавляет '/mnt/' к каждому значению в столбце 'mount_point'
            self.df['mount_point'] = MOUNT_BASE_PATH + self.df['mount_point'].astype(str)
            
            self.df['status'] = 'ВЫКЛ'
            self.df['disk_id'] = self.df.apply(
                lambda row: f"{chr(ord('A') + row['module'] - 1)}{row['position']}",
                axis=1
            )
            self.df.set_index('disk_id', inplace=True)
            self.logger.info(f"Пример преобразованного пути: {self.df['mount_point'].iloc[0]}")

        except FileNotFoundError:
            self.console.print(f"[bold red]Ошибка: Файл {csv_path} не найден.[/bold red]")
            self.logger.error(f"Файл конфигурации {csv_path} не найден.")
            exit()

        self.check_initial_state()

    # ... весь остальной код остается без изменений ...
    # Копипаст остального кода из предыдущей версии
    def setup_logging(self):
        self.logger = logging.getLogger(__name__)
        self.logger.setLevel(logging.INFO)
        file_handler = logging.FileHandler(LOG_FILE)
        formatter = logging.Formatter('%(asctime)s - %(levelname)s - %(message)s')
        file_handler.setFormatter(formatter)
        if not self.logger.handlers:
            self.logger.addHandler(file_handler)
        self.logger.info("--- Утилита запущена ---")

    def _run_command(self, command, capture=False):
        self.logger.info(f"Выполнение команды: {command}")
        try:
            result = subprocess.run(
                command, shell=True, check=True, capture_output=capture, text=True, stderr=subprocess.PIPE
            )
            if result.stdout: self.logger.info(f"STDOUT: {result.stdout.strip()}")
            return result
        except subprocess.CalledProcessError as e:
            self.console.print(f"[bold red]Ошибка выполнения команды:[/bold red] `{command}`")
            self.console.print(f"[red]Stderr: {e.stderr.strip()}[/red]")
            self.logger.error(f"Ошибка команды '{command}'. Stderr: {e.stderr.strip()}")
            return None
    
    def check_initial_state(self):
        self.logger.info("Проверка начального состояния дисков...")
        for disk_id, row in self.df.iterrows():
            if os.path.ismount(row['mount_point']):
                self.df.loc[disk_id, 'status'] = 'СМОНТИРОВАН'
        active_disks = len(self.df[self.df['status'] == 'СМОНТИРОВАН'])
        self.logger.info(f"Обнаружено {active_disks} активных дисков.")
    
    def _get_disk_usage(self, mount_point):
        try:
            total, used, free = shutil.disk_usage(mount_point)
            total_tb = round(total / (1024**4), 2)
            free_tb = round(free / (1024**4), 2)
            return f"[cyan]{total_tb:.2f}ТБ / {free_tb:.2f}ТБ[/cyan]"
        except FileNotFoundError:
            return "[red]Ошибка[/red]"
            
    def display_grid_chess_style(self):
        self.console.clear()
        table = Table(title="Состояние дисковой полки", title_style="bold magenta")
        min_module = self.df['module'].min()
        max_module = self.df['module'].max()
        min_position = self.df['position'].min()
        max_position = self.df['position'].max()
        table.add_column("Позиция", justify="center", style="cyan", no_wrap=True)
        module_headers = [chr(ord('A') + i - 1) for i in range(min_module, max_module + 1)]
        for header in module_headers:
            table.add_column(header, justify="center")
        table.add_column("Позиция", justify="center", style="cyan", no_wrap=True)
        grid_data = {}
        for disk_id, row in self.df.iterrows():
            pos, mod = row['position'], row['module']
            if pos not in grid_data:
                grid_data[pos] = {}
            grid_data[pos][mod] = {'status': row['status'], 'mount_point': row['mount_point']}
        for pos_num in range(max_position, min_position - 1, -1):
            row_cells = [str(pos_num)]
            for mod_num in range(min_module, max_module + 1):
                disk_info = grid_data.get(pos_num, {}).get(mod_num)
                if disk_info:
                    if disk_info['status'] == 'СМОНТИРОВАН':
                        usage = self._get_disk_usage(disk_info['mount_point'])
                        cell_content = f"[bold green]●[/bold green]\n{usage}"
                    else:
                        cell_content = "[dim]●[/dim]"
                else:
                    cell_content = ""
                row_cells.append(cell_content)
            row_cells.append(str(pos_num))
            table.add_row(*row_cells)
        self.console.print(table)
        legend = Text.assemble(
            ("Легенда: ", "bold"),
            ("●", "bold green"), " - Диск включен/смонтирован  ",
            ("●", "dim"), " - Диск выключен"
        )
        self.console.print(legend)
        active_count = len(self.df[self.df['status'] == 'СМОНТИРОВАН'])
        self.console.print(f"\nАктивных дисков: [bold {'green' if active_count <= MAX_ACTIVE_DISKS else 'red'}]{active_count}[/bold {'green' if active_count <= MAX_ACTIVE_DISKS else 'red'}] из {MAX_ACTIVE_DISKS} возможных.")

    def power_on_and_mount(self, disk_id):
        disk_id = disk_id.upper()
        self.logger.info(f"Начало операции включения для диска {disk_id}.")
        if disk_id not in self.df.index:
            self.console.print(f"[bold red]Ошибка: Диск {disk_id} не найден в конфигурации.[/bold red]")
            self.logger.error(f"Попытка включить несуществующий диск {disk_id}.")
            return
        disk_info = self.df.loc[disk_id]
        if disk_info['status'] == 'СМОНТИРОВАН':
            self.console.print(f"[yellow]Диск {disk_id} уже включен и смонтирован.[/yellow]")
            self.logger.warning(f"Попытка включить уже работающий диск {disk_id}.")
            return
        active_count = len(self.df[self.df['status'] == 'СМОНТИРОВАН'])
        if active_count >= MAX_ACTIVE_DISKS:
            self.console.print(f"[bold red]Достигнут лимит в {MAX_ACTIVE_DISKS} одновременно включенных дисков![/bold red]")
            self.logger.error(f"Превышен лимит дисков ({active_count}/{MAX_ACTIVE_DISKS}) при попытке включить {disk_id}.")
            return
        m, n = disk_info['module'], disk_info['position']
        wwn, mount_point = disk_info['wwn'], disk_info['mount_point']
        self.console.print(f"Включение диска {disk_id} (Модуль: {m}, Позиция: {n})...")
        power_on_cmd = f"echo -ne '#hdd_m{m} n{n} on\\n\\r' > {self.serial_port}"
        if self._run_command(power_on_cmd) is None: return
        self.console.print(f"Ожидание {DISK_POWER_ON_DELAY_SEC} секунд, пока диск определится системой...")
        self.logger.info(f"Задержка на {DISK_POWER_ON_DELAY_SEC} секунд для диска {wwn}.")
        time.sleep(DISK_POWER_ON_DELAY_SEC)
        device_path = f"/dev/disk/by-id/{wwn}"
        self.logger.info(f"Проверка существования файла устройства: {device_path}")
        if not os.path.exists(device_path):
            self.console.print(f"[bold red]Ошибка: Диск включился, но система не обнаружила его за {DISK_POWER_ON_DELAY_SEC} сек.[/bold red]")
            self.console.print("[yellow]Рекомендация: Попробуйте увеличить 'DISK_POWER_ON_DELAY_SEC' в скрипте до 15 или 20.[/yellow]")
            self.logger.error(f"Файл устройства {device_path} НЕ НАЙДЕН после задержки.")
            self.power_off_and_unmount(disk_id, is_retry=True)
            return
        self.logger.info(f"Файл устройства {device_path} НАЙДЕН. Создание точки монтирования {os.path.abspath(mount_point)}.")
        os.makedirs(mount_point, exist_ok=True)
        self.console.print(f"Монтирование {device_path} в {mount_point} с опциями...")
        mount_cmd = f"mount -o {MOUNT_OPTIONS} {device_path} {mount_point}"
        if self._run_command(mount_cmd) is None:
            self.console.print(f"[bold red]Не удалось смонтировать диск. Проверьте лог 'disk_manager.log'.[/bold red]")
            self.logger.error(f"Команда монтирования завершилась с ошибкой для диска {disk_id}.")
            self.power_off_and_unmount(disk_id, is_retry=True)
            return
        if os.path.ismount(mount_point):
            self.df.loc[disk_id, 'status'] = 'СМОНТИРОВАН'
            self.console.print(f"[bold green]Диск {disk_id} успешно включен и смонтирован![/bold green]")
            self.logger.info(f"Диск {disk_id} УСПЕШНО смонтирован в {mount_point}.")
        else:
            self.console.print(f"[bold red]Критическая ошибка: команда mount выполнилась, но точка не смонтирована.[/bold red]")
            self.logger.critical(f"Команда mount для {disk_id} выполнилась без ошибки, но os.path.ismount() == False.")
            
    def power_off_and_unmount(self, disk_id, is_retry=False):
        disk_id = disk_id.upper()
        self.logger.info(f"Начало операции выключения для диска {disk_id}.")
        if disk_id not in self.df.index:
            self.console.print(f"[bold red]Ошибка: Диск {disk_id} не найден в конфигурации.[/bold red]")
            return
        disk_info = self.df.loc[disk_id]
        if disk_info['status'] == 'ВЫКЛ' and not is_retry:
            self.console.print(f"[yellow]Диск {disk_id} уже выключен.[/yellow]")
            return
        m, n = disk_info['module'], disk_info['position']
        mount_point = disk_info['mount_point']
        if os.path.ismount(mount_point):
            self.console.print(f"Отмонтирование {mount_point}...")
            umount_cmd = f"umount {mount_point}"
            self._run_command(umount_cmd)
            time.sleep(1)
        self.console.print(f"Выключение диска {disk_id} (Модуль: {m}, Позиция: {n})...")
        power_off_cmd = f"echo -ne '#hdd_m{m} n{n} off\\n\\r' > {self.serial_port}"
        self._run_command(power_off_cmd)
        self.df.loc[disk_id, 'status'] = 'ВЫКЛ'
        self.console.print(f"[bold green]Диск {disk_id} выключен.[/bold green]")
        self.logger.info(f"Диск {disk_id} успешно выключен.")

    def main_loop(self):
        while True:
            self.display_grid_chess_style()
            self.console.print("\n[bold]Выберите действие:[/bold]")
            self.console.print("  [cyan]1[/cyan]. Включить/смонтировать диск")
            self.console.print("  [cyan]2[/cyan]. Выключить/отмонтировать диск")
            self.console.print("  [cyan]3[/cyan]. Обновить таблицу")
            self.console.print("  [cyan]q[/cyan]. Выход")
            choice = Prompt.ask("Ваш выбор", choices=['1', '2', '3', 'q'], default='3')
            if choice == '1':
                disk_id = Prompt.ask("Введите ID диска для включения (например, C5)")
                self.power_on_and_mount(disk_id)
                input("\nНажмите Enter для продолжения...")
            elif choice == '2':
                disk_id = Prompt.ask("Введите ID диска для выключения (например, A1)")
                self.power_off_and_unmount(disk_id)
                input("\nНажмите Enter для продолжения...")
            elif choice == '3':
                continue
            elif choice == 'q':
                self.logger.info("--- Утилита завершила работу ---")
                self.console.print("[bold]Завершение работы.[/bold]")
                break

if __name__ == "__main__":
    if os.geteuid() != 0:
        print("Этот скрипт требует прав суперпользователя (root) для выполнения команд mount/umount.")
        print("Пожалуйста, запустите его через sudo: sudo python3 disk_state.py")
        exit()
    manager = DiskManager(CSV_FILE, SERIAL_PORT)
    manager.main_loop()
